# Public configuration. Trading-chain selection stays in each request.
TELEGRAPH_NETWORK=telegraph-sepolia
TELEGRAPH_GATEWAY=https://devnode.telegraphprotocol.com/engine
TELEGRAPH_SEPOLIA_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
# Retain this RPC for recovery of earlier Base Sepolia reviews.
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org

# A dedicated payer key and operator token are required for paid reviews.
# Keep these server-side. Never reuse the miner-owner or a funded mainnet key.
AGENT_PRIVATE_KEY=
DESK_ACCESS_TOKEN=
# Local development can persist to SQLite. A Vercel deployment needs a remote
# libSQL/Turso URL and auth token shared by every instance.
REVIEW_DB_URL=file:.data/reviews.db
REVIEW_DB_AUTH_TOKEN=
DESK_DAILY_LIMIT_USDC=1

# Optional explanations for the legacy pool-research UI.
QWEN_API_KEY=
QWEN_BASE_URL=
QWEN_MODEL=

# Registration script: dry-run by default; --broadcast sends only after validation.
REGISTER_PRIVATE_KEY=
FEE_ADDRESS=
REGISTER_ID=401
REGISTER_YAML_URL=https://arcadian-gamma.vercel.app/telegraph-risk.yaml
# The published anonymous validator currently returns 404. The developer
# console uses this authenticated API; copy its token into your local operator
# environment, never into a public manifest.
TELEGRAPH_VALIDATION_URL=https://backend.telegraphprotocol.com/registrations/validate
TELEGRAPH_CONSOLE_TOKEN=
